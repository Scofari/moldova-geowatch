{
  "name": "moldova-geowatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @geowatch/api\" \"npm run dev -w @geowatch/web\"",
    "build": "npm run build -w @geowatch/shared && npm run build -w @geowatch/api && npm run build -w @geowatch/web",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:refresh": "tsx scripts/fetch-geodata.ts",
    "db:migrate": "npm run migrate -w @geowatch/api",
    "predev": "npm run build -w @geowatch/shared",
    "pretest": "npm run build -w @geowatch/shared",
    "pretypecheck": "npm run build -w @geowatch/shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.11"
  }
}
